{% extends 'base.html.twig' %}

{% block title %}Gestión de Backups - Clientes No Facturables{% endblock %}

{% block page_title %}Gestión de Backups{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h1 class="card-title">
                        <i class="bi bi-hdd-network"></i>
                        Gestión de Backups - Clientes No Facturables
                    </h1>
                    <div class="card-tools">
                        <a href="{{ path('app_client_index') }}" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver a Clientes
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Modo Oculto Activo:</strong> Esta sección solo está disponible cuando el sistema está en modo oculto.
                        Los backups contienen datos de clientes no facturables que han sido eliminados del sistema.
                        <br><small class="text-muted">Los backups se guardan automáticamente en: <code>app/var/backups/</code></small>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card border-primary">
                                <div class="card-body text-center">
                                    <i class="bi bi-plus-circle fa-3x text-primary mb-3"></i>
                                    <h5>Crear Nuevo Backup</h5>
                                    <p class="text-muted">Genera un backup de todos los clientes no facturables y los elimina del sistema</p>
                                    <form method="post" action="{{ path('app_client_backup_non_billable') }}" onsubmit="return confirm('¿Estás seguro de que quieres crear un backup y eliminar todos los clientes no facturables? Esta acción no se puede deshacer.')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('backup-non-billable') }}">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-save"></i> Crear Backup y Eliminar
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border-info">
                                <div class="card-body text-center">
                                    <i class="bi bi-list fa-3x text-info mb-3"></i>
                                    <h5>Backups Existentes</h5>
                                    <p class="text-muted">Ver y gestionar backups anteriores</p>
                                    <p class="mb-0">
                                        <strong>{{ backups|length }}</strong> backup{{ backups|length != 1 ? 's' : '' }} disponible{{ backups|length != 1 ? 's' : '' }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    {% if backups %}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th><i class="bi bi-file-earmark-code"></i> Archivo</th>
                                    <th><i class="bi bi-calendar"></i> Fecha de Creación</th>
                                    <th><i class="bi bi-speedometer"></i> Tamaño</th>
                                    <th><i class="bi bi-gear"></i> Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for backup in backups %}
                                <tr>
                                    <td>
                                        <i class="bi bi-file-earmark-code text-primary"></i>
                                        <code>{{ backup.filename }}</code>
                                    </td>
                                    <td>
                                        <i class="bi bi-clock text-muted"></i>
                                        {{ backup.created|date('d/m/Y H:i:s') }}
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-speedometer"></i>
                                            {{ (backup.size / 1024)|round(2) }} KB
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="{{ path('app_backup_download', {'filename': backup.filename}) }}"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Descargar">
                                                <i class="bi bi-download"></i>
                                            </a>
                                            <form method="post"
                                                  action="{{ path('app_backup_restore', {'filename': backup.filename}) }}"
                                                  class="d-inline"
                                                  onsubmit="return confirm('¿Estás seguro de que quieres restaurar este backup? Esto agregará los datos de vuelta al sistema.')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('restore-' ~ backup.filename) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Restaurar">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            </form>
                                            <form method="post"
                                                  action="{{ path('app_backup_delete', {'filename': backup.filename}) }}"
                                                  class="d-inline"
                                                  onsubmit="return confirm('¿Estás seguro de que quieres eliminar este backup? Esta acción no se puede deshacer.')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete-' ~ backup.filename) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <div class="text-center py-5">
                        <i class="bi bi-hdd-network fa-4x text-muted mb-3"></i>
                        <h4 class="text-muted">No hay backups disponibles</h4>
                        <p class="text-muted">Crea tu primer backup usando el botón de arriba.</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
