{% extends 'base.html.twig' %}

{% block title %}Editar Perfil - GymAdmin{% endblock %}
{% block page_title %}Editar Perfil{% endblock %}

{% block body %}

<div class="page-header mb-4">
    <div class="page-header-left">
        <div>
            <h2 class="page-header-title">
                <i class="bi bi-person-gear me-2" style="color:var(--c-primary,#D72638)"></i>Configuración de Perfil
            </h2>
            <p class="page-header-sub">Gestión de cuenta de usuario y datos fiscales de la empresa</p>
        </div>
    </div>
</div>

<div class="card" style="max-width: 860px;">
    <div class="card-body">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

            <!-- Información de Usuario -->
            <p class="card-section-title">
                <i class="bi bi-person me-2" aria-hidden="true"></i>Cuenta de Administrador
            </p>
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-8">
                    {{ form_label(form.email, 'Correo electrónico', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'admin@gimnasio.com'}}) }}
                    {{ form_errors(form.email) }}
                    <div class="form-text">Utilizado para el inicio de sesión en el sistema.</div>
                </div>
            </div>

            <!-- Información de Empresa -->
            <p class="card-section-title">
                <i class="bi bi-building me-2" aria-hidden="true"></i>Datos Fiscales de la Empresa
            </p>
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    {{ form_label(form.companyName, 'Nombre o Razón Social', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.companyName, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.companyName) }}
                </div>
                <div class="col-12 col-md-6">
                    {{ form_label(form.taxId, 'NIF / CIF', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.taxId, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.taxId) }}
                </div>
                <div class="col-12">
                    {{ form_label(form.companyAddress, 'Dirección fiscal', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.companyAddress, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.companyAddress) }}
                </div>
                <div class="col-12 col-md-6">
                    {{ form_label(form.locality, 'Localidad', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.locality, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.locality) }}
                </div>
                <div class="col-12 col-md-6">
                    {{ form_label(form.zipCode, 'Código Postal', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.zipCode, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.zipCode) }}
                </div>
                <div class="col-12 col-md-6">
                    {{ form_label(form.companyPhone, 'Teléfono de contacto', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.companyPhone, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.companyPhone) }}
                </div>
                <div class="col-12 col-md-6">
                    {{ form_label(form.companyEmail, 'Email de facturación', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.companyEmail, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.companyEmail) }}
                </div>
                <div class="col-12 col-md-6">
                    {{ form_label(form.companyProvince, 'Provincia', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.companyProvince, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.companyProvince) }}
                </div>
                <div class="col-12 col-md-6">
                    {{ form_label(form.companyCountry, 'País', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.companyCountry, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.companyCountry) }}
                </div>
                <div class="col-12 col-md-8">
                    {{ form_label(form.companyIban, 'Cuenta Bancaria de la Empresa (IBAN para emisión de remesas)', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.companyIban, {'attr': {'class': 'form-control font-monospace'}}) }}
                    {{ form_errors(form.companyIban) }}
                    <div class="form-text">Cuenta donde se abonarán las remesas bancarias SEPA XML.</div>
                </div>
                <div class="col-12 col-md-4">
                    {{ form_label(form.companyBic, 'Código BIC / SWIFT', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.companyBic, {'attr': {'class': 'form-control font-monospace'}}) }}
                    {{ form_errors(form.companyBic) }}
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 justify-content-end pt-3" style="border-top:1px solid var(--c-gray-100)">
                <a href="{{ path('dashboard') }}" class="btn btn-outline-secondary">
                    Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>Guardar cambios
                </button>
            </div>

        {{ form_end(form) }}
    </div>
</div>

{% endblock %}
