{% extends 'base.html.twig' %}

{% block title %}Editar Perfil{% endblock %}

{% block page_title %}Editar Perfil{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow">
                    <div class="card-body">
                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                            <!-- Información de Usuario -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h5 class="card-section-title mb-3" style="font-size:1rem;color:var(--c-primary);border-bottom:none;padding-bottom:0;">
                                        <i class="bi bi-person me-2"></i>Información de Usuario
                                    </h5>
                                </div>
                                <div class="col-md-12">
                                    <div class="mb-3">
                                        {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(form.email) }}
                                    </div>
                                </div>
                            </div>

                            <!-- Información de Empresa -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h5 class="card-section-title mb-3" style="font-size:1rem;color:var(--c-primary);border-bottom:none;padding-bottom:0;">
                                        <i class="bi bi-building me-2"></i>Información de Empresa
                                    </h5>
                                    <p class="text-muted small">Estos datos se utilizarán en las facturas electrónicas</p>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.companyName, 'Nombre de la Empresa', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.companyName, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(form.companyName) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.taxId, 'NIF/CIF', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.taxId, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(form.taxId) }}
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="mb-3">
                                        {{ form_label(form.companyAddress, 'Dirección', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.companyAddress, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(form.companyAddress) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.locality, 'Localidad', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.locality, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(form.locality) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.zipCode, 'Código Postal', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.zipCode, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(form.zipCode) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.companyPhone, 'Teléfono', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.companyPhone, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(form.companyPhone) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.companyProvince, 'Provincia', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.companyProvince, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(form.companyProvince) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.companyCountry, 'País', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.companyCountry, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(form.companyCountry) }}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.companyEmail, 'Email de la Empresa', {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.companyEmail, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(form.companyEmail) }}
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12">
                                    <button type="submit" class="btn btn-success me-2">
                                        <i class="bi bi-check-lg me-2"></i>Guardar Cambios
                                    </button>
                                    <a href="{{ path('dashboard') }}" class="btn btn-secondary">
                                        <i class="bi bi-arrow-left me-2"></i>Volver al Dashboard
                                    </a>
                                </div>
                            </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
