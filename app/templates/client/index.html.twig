{% extends 'base.html.twig' %}

{% block title %}Clientes - GymAdmin{% endblock %}

{% block page_title %}Clientes{% endblock %}

{% block body %}

{# ─── Page header ─── #}
<div class="page-header">
    <div class="page-header-left">
        <div>
            <h2 class="page-header-title">Gestión de clientes</h2>
            <p class="page-header-sub">Lista y búsqueda de clientes del gimnasio</p>
        </div>
    </div>
    <a href="{{ path('app_client_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nuevo cliente
    </a>
</div>

{# ─── Filters ─── #}
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="{{ path('app_client_index') }}" role="search" aria-label="Filtrar clientes">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-sm-6 col-lg-4">
                    <label class="form-label" for="search">Buscar</label>
                    <div class="search-wrapper">
                        <i class="bi bi-search search-icon" aria-hidden="true"></i>
                        <input type="text" id="search" name="search" class="form-control"
                               placeholder="Nombre o apellidos..." value="{{ search|default('') }}" autocomplete="off">
                    </div>
                </div>
                <div class="col-6 col-sm-3 col-lg-2">
                    <label class="form-label" for="paid">Estado</label>
                    <select id="paid" name="paid" class="form-select">
                        <option value="" {% if paid is not defined or paid == '' %}selected{% endif %}>Todos</option>
                        <option value="1" {% if paid == '1' %}selected{% endif %}>Pagado</option>
                        <option value="0" {% if paid == '0' %}selected{% endif %}>Pendiente</option>
                    </select>
                </div>
                <div class="col-6 col-sm-3 col-lg-2">
                    <label class="form-label" for="perPage">Por página</label>
                    <select id="perPage" name="perPage" class="form-select">
                        <option value="12" {% if perPage|default(12) == 12 %}selected{% endif %}>12</option>
                        <option value="24" {% if perPage == 24 %}selected{% endif %}>24</option>
                        <option value="36" {% if perPage == 36 %}selected{% endif %}>36</option>
                        <option value="48" {% if perPage == 48 %}selected{% endif %}>48</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-4 d-flex gap-2">
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-funnel me-1" aria-hidden="true"></i>Filtrar
                    </button>
                    {% if search|default('') or (paid is defined and paid != '') or (perPage is defined and perPage != 12) %}
                        <a href="{{ path('app_client_index') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1" aria-hidden="true"></i>Limpiar
                        </a>
                    {% endif %}
                </div>
            </div>
        </form>
    </div>
</div>

{# ─── Client grid ─── #}
{% if clients|length > 0 %}
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-4">
        {% for clientData in clients %}
            <div class="col">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column gap-3">

                        {# Header row #}
                        <div class="d-flex align-items-center gap-3">
                            <span class="client-avatar-sm flex-shrink-0" aria-hidden="true">
                                {{ clientData.client.name|slice(0,1)|upper }}{{ clientData.client.surname|slice(0,1)|upper }}
                            </span>
                            <div class="flex-grow-1 min-width-0">
                                <div class="fw-semibold text-truncate" style="color:var(--c-gray-900)">
                                    {{ clientData.client.name }} {{ clientData.client.surname }}
                                </div>
                                <div class="small" style="color:var(--c-gray-500)">
                                    #{{ clientData.client.id }}
                                    {% if clientData.client.phone %}· {{ clientData.client.phone }}{% endif %}

                                </div>
                            </div>
                            <span class="badge-status {% if clientData.hasPaid %}badge-paid{% else %}badge-pending{% endif %}" aria-label="{{ clientData.hasPaid ? 'Pagado' : 'Pendiente' }}">
                                <span class="dot" aria-hidden="true"></span>
                                {{ clientData.hasPaid ? 'Pagado' : 'Pendiente' }}
                            </span>
                        </div>

                        {# Subscription info #}
                        <div class="d-flex align-items-center gap-2 small" style="color:var(--c-gray-600)">
                            <i class="bi bi-journal-text" aria-hidden="true"></i>
                            <span>{{ clientData.subscriptionType ?: '—' }}</span>
                        </div>

                        {# Actions #}
                        <div class="d-flex gap-2 mt-auto pt-2" style="border-top:1px solid var(--c-gray-100)">
                            <button type="button"
                                    class="btn btn-sm btn-outline-success btn-icon"
                                    data-bs-toggle="modal"
                                    data-bs-target="#renewModal{{ clientData.client.id }}"
                                    title="Renovar suscripción"
                                    aria-label="Renovar suscripción de {{ clientData.client.name }}">
                                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                            </button>
                            <a href="{{ path('app_client_show', {'id': clientData.client.id}) }}"
                               class="btn btn-sm btn-outline-secondary btn-icon"
                               title="Ver ficha" aria-label="Ver ficha de {{ clientData.client.name }}">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </a>
                            <a href="{{ path('app_client_edit', {'id': clientData.client.id}) }}"
                               class="btn btn-sm btn-primary btn-icon"
                               title="Editar" aria-label="Editar {{ clientData.client.name }}">
                                <i class="bi bi-pencil" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            {# Renew modal #}
            <div class="modal fade" id="renewModal{{ clientData.client.id }}" tabindex="-1"
                 aria-labelledby="renewModalLabel{{ clientData.client.id }}" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-sm">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title fs-6" id="renewModalLabel{{ clientData.client.id }}">
                                Confirmar renovación
                            </h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-1 fw-semibold">{{ clientData.client.name }} {{ clientData.client.surname }}</p>
                            <p class="small mb-2" style="color:var(--c-gray-500)">
                                {{ clientData.subscriptionType ?: 'Sin suscripción asignada' }}
                            </p>
                            <p class="small mb-0">¿Renovar la suscripción por un mes más?</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <form method="post" action="{{ path('app_client_renew', {'id': clientData.client.id}) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('renew' ~ clientData.client.id) }}">
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Renovar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

{% else %}
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-people empty-state-icon" aria-hidden="true"></i>
            <p class="empty-state-title">No se encontraron clientes</p>
            <p class="empty-state-desc">Prueba con otros filtros o añade un nuevo cliente.</p>
            <a href="{{ path('app_client_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Añadir cliente
            </a>
        </div>
    </div>
{% endif %}

{# ─── Pagination ─── #}
{% if totalPages is defined and totalPages > 1 %}
    <nav aria-label="Paginación de clientes" class="mt-3">
        <ul class="pagination justify-content-center flex-wrap">
            {% if currentPage > 1 %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('app_client_index', {search: search|default(''), paid: paid|default(''), perPage: perPage|default(12), page: currentPage - 1}) }}" aria-label="Anterior">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </a>
                </li>
            {% endif %}
            {% for page in 1..totalPages %}
                <li class="page-item {% if page == currentPage %}active{% endif %}">
                    <a class="page-link" href="{{ path('app_client_index', {search: search|default(''), paid: paid|default(''), perPage: perPage|default(12), page: page}) }}"
                       {% if page == currentPage %}aria-current="page"{% endif %}>{{ page }}</a>
                </li>
            {% endfor %}
            {% if currentPage < totalPages %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('app_client_index', {search: search|default(''), paid: paid|default(''), perPage: perPage|default(12), page: currentPage + 1}) }}" aria-label="Siguiente">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                </li>
            {% endif %}
        </ul>
    </nav>
{% endif %}

{% endblock %}
