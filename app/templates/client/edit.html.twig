{% extends 'base.html.twig' %}

{% block title %}Editar {{ client.name }} {{ client.surname }} - GymAdmin{% endblock %}
{% block page_title %}Editar cliente{% endblock %}

{% block body %}
{% set returnTo = app.request.query.get('return_to') %}
{% set backUrl = returnTo == 'dashboard' ? path('dashboard') : path('app_client_show', {'id': client.id}) %}

<div class="page-header">
    <div class="page-header-left">
        <a href="{{ backUrl }}" class="btn btn-sm btn-outline-secondary btn-icon"
           aria-label="Volver">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
        </a>
        <div>
            <h2 class="page-header-title">{{ client.name }} {{ client.surname }}</h2>
            <p class="page-header-sub">Editando datos del cliente #{{ client.id }}</p>
        </div>
    </div>
</div>

<div class="card" style="max-width:860px">
    <div class="card-body">
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
        {% if returnTo %}
            <input type="hidden" name="return_to" value="{{ returnTo }}">
        {% endif %}

            <p class="card-section-title">
                <i class="bi bi-person" aria-hidden="true"></i>Información personal
            </p>
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name) }}
                    {{ form_errors(form.name) }}
                </div>
                <div class="col-12 col-md-6">
                    {{ form_label(form.surname) }}
                    {{ form_widget(form.surname) }}
                    {{ form_errors(form.surname) }}
                </div>
                <div class="col-12 col-md-6">
                    {{ form_label(form.idNumber) }}
                    {{ form_widget(form.idNumber) }}
                    {{ form_errors(form.idNumber) }}
                </div>
                <div class="col-12 col-md-6">
                    {{ form_label(form.birthDate) }}
                    {{ form_widget(form.birthDate) }}
                    {{ form_errors(form.birthDate) }}
                </div>
            </div>

            <p class="card-section-title">
                <i class="bi bi-telephone" aria-hidden="true"></i>Contacto y dirección
            </p>
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    {{ form_label(form.phone) }}
                    {{ form_widget(form.phone) }}
                    {{ form_errors(form.phone) }}
                </div>
                <div class="col-12 col-md-6">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>
                <div class="col-12">
                    {{ form_label(form.address) }}
                    {{ form_widget(form.address) }}
                    {{ form_errors(form.address) }}
                </div>
                <div class="col-12 col-md-8">
                    {{ form_label(form.locality) }}
                    {{ form_widget(form.locality) }}
                    {{ form_errors(form.locality) }}
                </div>
                <div class="col-12 col-md-4">
                    {{ form_label(form.zipCode) }}
                    {{ form_widget(form.zipCode) }}
                    {{ form_errors(form.zipCode) }}
                </div>
                <div class="col-12">
                    {{ form_label(form.iban) }}
                    {{ form_widget(form.iban) }}
                    {{ form_errors(form.iban) }}
                    <div class="form-text">Cuenta bancaria para remesas SEPA (Norma 19 / XML ISO 20022). Formato español: ES...</div>
                </div>
            </div>

            <p class="card-section-title">
                <i class="bi bi-credit-card" aria-hidden="true"></i>Membresía
            </p>
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    {{ form_label(form.cardCode) }}
                    {{ form_widget(form.cardCode) }}
                    <div class="form-text"><i class="bi bi-info-circle me-1"></i>Haz clic para escanear una tarjeta</div>
                    {{ form_errors(form.cardCode) }}
                </div>
                <div class="col-12 col-md-6">
                    {{ form_label(form.startDate) }}
                    {{ form_widget(form.startDate) }}
                    {{ form_errors(form.startDate) }}
                </div>

                {# ── Foto ── #}
                <div class="col-12">
                    <div class="p-3 rounded" style="background:var(--c-gray-50);border:1px solid var(--c-gray-200)">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            {% if client.photo %}
                                <img src="{{ asset('uploads/clients/' ~ client.photo) }}"
                                     alt="Foto actual"
                                     class="rounded-circle object-fit-cover border"
                                     style="width:56px;height:56px;border-width:2px!important;border-color:var(--c-gray-200)!important">
                                <div class="small text-muted">Foto actual. Sube otra para reemplazarla.</div>
                            {% else %}
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center"
                                     style="width:56px;height:56px;background:var(--c-gray-100);color:var(--c-gray-400);font-size:1.5rem">
                                    <i class="bi bi-person" aria-hidden="true"></i>
                                </div>
                                <div class="small text-muted">Sin foto. Sube una imagen del cliente.</div>
                            {% endif %}
                        </div>
                        {{ form_label(form.photo) }}
                        {{ form_widget(form.photo) }}
                        {{ form_errors(form.photo) }}
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    {{ form_label(form.subscriptionType) }}
                    {{ form_widget(form.subscriptionType) }}
                    {{ form_errors(form.subscriptionType) }}
                </div>
                <div class="col-12 col-md-6">
                    <div class="p-3 rounded" style="background:var(--c-gray-50);border:1px solid var(--c-gray-200)">
                        <div class="form-check mb-3">
                            {{ form_widget(form.isPaid) }}
                            {{ form_label(form.isPaid) }}
                        </div>
                        <div id="regularSubscriptionFields">
                            {{ form_label(form.paymentUntil) }}
                            {{ form_widget(form.paymentUntil) }}
                            {{ form_errors(form.paymentUntil) }}
                        </div>
                        <div id="dailyPassFields" style="display:none">
                            {{ form_label(form.remainingPasses) }}
                            {{ form_widget(form.remainingPasses) }}
                            <div class="form-text"><i class="bi bi-info-circle me-1"></i>Número de pases disponibles</div>
                            {{ form_errors(form.remainingPasses) }}
                        </div>
                    </div>
                </div>
            </div>

            <p class="card-section-title">
                <i class="bi bi-chat-quote" aria-hidden="true"></i>Pantalla del torno
            </p>
            <div class="row g-3 mb-4">
                <div class="col-12">
                    {{ form_label(form.welcomeMessage) }}
                    {{ form_widget(form.welcomeMessage) }}
                    {{ form_help(form.welcomeMessage) }}
                    {{ form_errors(form.welcomeMessage) }}
                </div>
            </div>

            <div class="d-flex align-items-center gap-3 pt-2" style="border-top:1px solid var(--c-gray-100)">
                <div class="form-check me-auto" style="opacity:.6;font-size:.85rem">
                    {{ form_widget(form.billable) }}
                    <label class="form-check-label" for="{{ form.billable.vars.id }}">Gestión externa</label>
                </div>
                <a href="{{ backUrl }}" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>Guardar cambios
                </button>
            </div>

        {{ form_end(form) }}
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('client_forms') }}
{% endblock %}
