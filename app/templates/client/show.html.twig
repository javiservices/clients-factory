{% extends 'base.html.twig' %}

{% block title %}{{ client.name }} {{ client.surname }} - GymAdmin{% endblock %}
{% block page_title %}Ficha de cliente{% endblock %}

{% block body %}

{# ─── Page header ─── #}
<div class="page-header">
    <div class="page-header-left">
        <a href="{{ path('app_client_index') }}" class="btn btn-sm btn-outline-secondary btn-icon"
           aria-label="Volver a la lista de clientes">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
        </a>
        <div>
            <h2 class="page-header-title">{{ client.name }} {{ client.surname }}</h2>
            <p class="page-header-sub">ID #{{ client.id }}</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_client_edit', {'id': client.id}) }}" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1" aria-hidden="true"></i>Editar
        </a>
        <button type="button" class="btn btn-sm btn-outline-danger"
                data-bs-toggle="modal" data-bs-target="#deleteModal"
                aria-label="Eliminar cliente">
            <i class="bi bi-trash" aria-hidden="true"></i>
        </button>
    </div>
</div>

<div class="row g-3">

    {# ─── Personal info ─── #}
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <p class="card-section-title">
                    <i class="bi bi-person" aria-hidden="true"></i>Información personal
                </p>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="small" style="color:var(--c-gray-500)">Nombre</div>
                        <div class="fw-semibold">{{ client.name }}</div>
                    </div>
                    <div class="col-6">
                        <div class="small" style="color:var(--c-gray-500)">Apellidos</div>
                        <div class="fw-semibold">{{ client.surname }}</div>
                    </div>
                    <div class="col-6">
                        <div class="small" style="color:var(--c-gray-500)">DNI / NIF</div>
                        <div class="fw-semibold">{{ client.idNumber ?: '—' }}</div>
                    </div>
                    <div class="col-6">
                        <div class="small" style="color:var(--c-gray-500)">Fecha de nacimiento</div>
                        <div class="fw-semibold">{{ client.birthDate ? client.birthDate|date('d/m/Y') : '—' }}</div>
                    </div>
                    <div class="col-6">
                        <div class="small" style="color:var(--c-gray-500)">Teléfono</div>
                        <div class="fw-semibold">{{ client.phone ?: '—' }}</div>
                    </div>
                    <div class="col-6">
                        <div class="small" style="color:var(--c-gray-500)">Email</div>
                        <div class="fw-semibold small text-truncate">{{ client.email ?: '—' }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ─── Address ─── #}
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <p class="card-section-title">
                    <i class="bi bi-geo-alt" aria-hidden="true"></i>Dirección
                </p>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="small" style="color:var(--c-gray-500)">Dirección</div>
                        <div class="fw-semibold">{{ client.address ?: '—' }}</div>
                    </div>
                    <div class="col-7">
                        <div class="small" style="color:var(--c-gray-500)">Localidad</div>
                        <div class="fw-semibold">{{ client.locality ?: '—' }}</div>
                    </div>
                    <div class="col-5">
                        <div class="small" style="color:var(--c-gray-500)">Código postal</div>
                        <div class="fw-semibold">{{ client.zipCode ?: '—' }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ─── Membership ─── #}
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <p class="card-section-title">
                    <i class="bi bi-credit-card" aria-hidden="true"></i>Membresía
                </p>
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="small" style="color:var(--c-gray-500)">Código de tarjeta</div>
                        <div class="fw-semibold font-monospace">{{ client.cardCode ?: '—' }}</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small" style="color:var(--c-gray-500)">Fecha de alta</div>
                        <div class="fw-semibold">{{ client.startDate ? client.startDate|date('d/m/Y') : '—' }}</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small" style="color:var(--c-gray-500)">Estado de pago</div>
                        <div class="mt-1">
                            {% if hasPaid %}
                                <span class="badge-status badge-paid"><span class="dot"></span>Pagado</span>
                            {% else %}
                                <span class="badge-status badge-pending"><span class="dot"></span>Pendiente</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="small" style="color:var(--c-gray-500)">Pagado hasta</div>
                        <div class="fw-semibold">{{ paymentUntil ? paymentUntil|date('d/m/Y') : '—' }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

{# ─── Delete modal ─── #}
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-6" id="deleteModalLabel">Confirmar eliminación</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">¿Eliminar a <strong>{{ client.name }} {{ client.surname }}</strong>?</p>
                <p class="small mb-0" style="color:var(--c-danger)">Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                {{ include('client/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>

{% endblock %}
