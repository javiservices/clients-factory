{% extends 'base.html.twig' %}

{% block title %}{{ client.name }} {{ client.surname }} - Santamaría Gym{% endblock %}
{% block page_title %}Ficha de cliente{% endblock %}

{% block body %}

{# ─── Page header ─── #}
<div class="page-header mb-4">
    <div class="page-header-left">
        <a href="{{ path('app_client_index') }}" class="btn btn-sm btn-outline-secondary btn-icon"
           aria-label="Volver a la lista de clientes">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
        </a>
        <div>
            <h2 class="page-header-title">{{ client.name }} {{ client.surname }}</h2>
            <p class="page-header-sub">Cliente #{{ client.id }}</p>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        {% if subscription %}
            <form method="post" action="{{ path('app_client_renew', {'id': client.id}) }}" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('renew' ~ client.id) }}">
                <button type="submit" class="btn btn-sm btn-success"
                        onclick="return confirm('¿Confirmas la renovación de la cuota para {{ client.name }}?')">
                    <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Renovar cuota
                </button>
            </form>
        {% endif %}
        <a href="{{ path('app_client_edit', {'id': client.id}) }}" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1" aria-hidden="true"></i>Editar
        </a>
        <button type="button" class="btn btn-sm btn-outline-danger btn-icon"
                data-bs-toggle="modal" data-bs-target="#deleteModal"
                aria-label="Eliminar cliente" title="Eliminar cliente">
            <i class="bi bi-trash" aria-hidden="true"></i>
        </button>
    </div>
</div>

<div class="row g-3">

    {# ─── Photo + Personal info ─── #}
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <p class="card-section-title">
                    <i class="bi bi-person" aria-hidden="true"></i>Información personal
                </p>
                {% if client.photo %}
                    <div class="text-center mb-3">
                        <img src="{{ asset('uploads/clients/' ~ client.photo) }}"
                             alt="Foto de {{ client.name }}"
                             class="rounded-circle object-fit-cover border"
                             style="width:96px;height:96px;border-color:var(--c-gray-200)!important;border-width:3px!important">
                    </div>
                {% else %}
                    <div class="text-center mb-3">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center"
                             style="width:96px;height:96px;background:var(--c-gray-100);font-size:2.5rem;color:var(--c-gray-400)">
                            <i class="bi bi-person" aria-hidden="true"></i>
                        </div>
                    </div>
                {% endif %}
                <div class="row g-3">
                    <div class="col-6">
                        <div class="small" style="color:var(--c-gray-500)">Nombre</div>
                        <div class="fw-semibold">{{ client.name }}</div>
                    </div>
                    <div class="col-6">
                        <div class="small" style="color:var(--c-gray-500)">Apellidos</div>
                        <div class="fw-semibold">{{ client.surname ?: '—' }}</div>
                    </div>
                    <div class="col-6">
                        <div class="small" style="color:var(--c-gray-500)">DNI / NIF</div>
                        <div class="fw-semibold font-monospace">{{ client.idNumber ?: '—' }}</div>
                    </div>
                    <div class="col-6">
                        <div class="small" style="color:var(--c-gray-500)">Fecha de nacimiento</div>
                        <div class="fw-semibold">{{ client.birthDate ? client.birthDate|date('d/m/Y') : '—' }}</div>
                    </div>
                    <div class="col-6">
                        <div class="small" style="color:var(--c-gray-500)">Teléfono</div>
                        <div class="fw-semibold">{{ client.phone ?: '—' }}</div>
                    </div>
                    <div class="col-6">
                        <div class="small" style="color:var(--c-gray-500)">Email</div>
                        <div class="fw-semibold small text-truncate">{{ client.email ?: '—' }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ─── Address & Fiscal ─── #}
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <p class="card-section-title">
                    <i class="bi bi-geo-alt" aria-hidden="true"></i>Dirección y Clasificación
                </p>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="small" style="color:var(--c-gray-500)">Dirección</div>
                        <div class="fw-semibold">{{ client.address ?: '—' }}</div>
                    </div>
                    <div class="col-7">
                        <div class="small" style="color:var(--c-gray-500)">Localidad</div>
                        <div class="fw-semibold">{{ client.locality ?: '—' }}</div>
                    </div>
                    <div class="col-5">
                        <div class="small" style="color:var(--c-gray-500)">Código postal</div>
                        <div class="fw-semibold">{{ client.zipCode ?: '—' }}</div>
                    </div>
                    <div class="col-12">
                        <div class="small" style="color:var(--c-gray-500)">Cuenta bancaria (IBAN)</div>
                        <div class="fw-semibold font-monospace">
                            {% if client.iban %}
                                <i class="bi bi-bank me-1 text-primary"></i>{{ client.iban }}
                            {% else %}
                                <span class="text-muted fw-normal">No especificado</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-12 pt-2 border-top">
                        <div class="small mb-1" style="color:var(--c-gray-500)">Gestión Externa (Facturación gestoría)</div>
                        {% if client.billable %}
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                <i class="bi bi-check-circle-fill me-1"></i>Habilitado (Incluido en remesas)
                            </span>
                        {% else %}
                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                                <i class="bi bi-dash-circle me-1"></i>No habilitado (Excluido de facturación externa)
                            </span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ─── Membership ─── #}
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                    <p class="card-section-title mb-0">
                        <i class="bi bi-credit-card" aria-hidden="true"></i>Membresía y Acceso
                    </p>
                    <div class="d-flex align-items-center gap-2">
                        {% if subscription %}
                            {% if subscription.frozen %}
                                <form method="post" action="{{ path('app_subscription_unfreeze', {'id': subscription.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('unfreeze' ~ subscription.id) }}">
                                    <button type="submit" class="btn btn-sm btn-warning">
                                        <i class="bi bi-snow me-1"></i>Descongelar
                                    </button>
                                </form>
                            {% else %}
                                <form method="post" action="{{ path('app_subscription_freeze', {'id': subscription.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('freeze' ~ subscription.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-info"
                                            onclick="return confirm('¿Congelar la suscripción? Los días congelados se añadirán al vencimiento al descongelar.')">
                                        <i class="bi bi-snow me-1"></i>Congelar
                                    </button>
                                </form>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>

                <div class="row g-3">
                    {# Plan actual #}
                    <div class="col-6 col-md-3">
                        <div class="small" style="color:var(--c-gray-500)">Plan actual</div>
                        <div class="fw-bold mt-1" style="color:var(--c-gray-900);">
                            {{ subscription ? subscription.subscriptionType.name : 'Sin suscripción' }}
                        </div>
                        {% if subscription %}
                            <div class="mt-1">
                                <span class="badge-status badge-info-tag">
                                    {{ subscription.subscriptionType.isDailyPass ? 'Pase Diario / Bono' : 'Mensualidad' }}
                                </span>
                            </div>
                        {% endif %}
                    </div>

                    {# Pases restantes si es bono #}
                    {% if subscription and subscription.subscriptionType.isDailyPass %}
                        <div class="col-6 col-md-3">
                            <div class="small" style="color:var(--c-gray-500)">Pases restantes</div>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <span class="badge bg-primary fs-6">{{ subscription.remainingPasses ?? 0 }}</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                        data-bs-toggle="modal" data-bs-target="#passesModal" style="font-size:0.75rem;">
                                    <i class="bi bi-pencil me-1"></i>Ajustar
                                </button>
                            </div>
                        </div>
                    {% endif %}

                    {# Código de tarjeta RFID #}
                    <div class="col-6 col-md-3">
                        <div class="small" style="color:var(--c-gray-500)">Tarjeta RFID</div>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            {% if client.cardCode %}
                                <span class="font-monospace fw-semibold">{{ client.cardCode }}</span>
                            {% else %}
                                <span class="badge bg-warning-subtle text-warning">Sin tarjeta</span>
                            {% endif %}
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                    data-bs-toggle="modal" data-bs-target="#cardModal" style="font-size:0.75rem;">
                                <i class="bi bi-credit-card-2-front me-1"></i>Asignar
                            </button>
                        </div>
                    </div>

                    {# Estado de pago #}
                    <div class="col-6 col-md-3">
                        <div class="small" style="color:var(--c-gray-500)">Estado de membresía</div>
                        <div class="mt-1">
                            {% if subscription and subscription.frozen %}
                                <span class="badge-status badge-pending"><span class="dot"></span>Congelada</span>
                            {% elseif hasPaid %}
                                <span class="badge-status badge-paid"><span class="dot"></span>Al corriente</span>
                            {% else %}
                                <span class="badge-status badge-pending"><span class="dot"></span>Pendiente</span>
                            {% endif %}
                        </div>
                    </div>

                    {# Pagado hasta y Último mes #}
                    <div class="col-6 col-md-3">
                        <div class="small" style="color:var(--c-gray-500)">Último mes abonado</div>
                        <div class="fw-semibold mt-1">
                            {{ lastPaidMonth ?: 'Sin pagos' }}
                            {% if paymentUntil %}
                                <div class="text-muted small fw-normal">(Hasta {{ paymentUntil|date('d/m/Y') }})</div>
                            {% endif %}
                        </div>
                    </div>

                    {# Fecha de alta #}
                    <div class="col-6 col-md-3">
                        <div class="small" style="color:var(--c-gray-500)">Fecha de alta</div>
                        <div class="fw-semibold mt-1">{{ client.startDate ? client.startDate|date('d/m/Y') : '—' }}</div>
                    </div>

                    {% if subscription and subscription.frozen %}
                        <div class="col-12">
                            <div class="alert alert-warning d-flex align-items-center gap-2 mb-0 py-2">
                                <i class="bi bi-snow fs-5"></i>
                                <span>Suscripción congelada desde el <strong>{{ subscription.frozenAt|date('d/m/Y') }}</strong>.
                                Al descongelar se extenderá el vencimiento por los días transcurridos.</span>
                            </div>
                        </div>
                    {% endif %}

                    {% if client.welcomeMessage %}
                        <div class="col-12">
                            <div class="alert border-0 shadow-sm d-flex align-items-center gap-3 p-3 rounded-3 mb-0" style="background: linear-gradient(135deg, rgba(215, 38, 56, 0.05), rgba(215, 38, 56, 0.12)); border-left: 4px solid var(--c-primary, #D72638) !important;">
                                <i class="bi bi-chat-quote-fill fs-3" style="color: var(--c-primary, #D72638);"></i>
                                <div>
                                    <div class="fw-bold small text-dark">Mensaje de bienvenida en pantalla del torno:</div>
                                    <div class="text-dark fst-italic fs-6">"{{ client.welcomeMessage }}"</div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# ─── Métricas y Estadísticas de Asistencia ─── #}
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-3">
                    <div>
                        <p class="card-section-title mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-graph-up-arrow text-primary" aria-hidden="true"></i>Estadísticas y Rentabilidad del Socio
                        </p>
                        <span class="text-muted small">Rendimiento de asistencia e inversión acumulada</span>
                    </div>

                    {% if client.totalPaid >= 50 and client.totalAccesses <= 5 %}
                    <a href="{{ path('app_statistics_diploma', {'id': client.id, 'preset': 'this_month'}) }}"
                       class="btn btn-sm btn-outline-warning text-dark fw-bold d-inline-flex align-items-center gap-1.5 shadow-sm"
                       style="background: #FFFBEB; border-color: #F59E0B;">
                        <i class="bi bi-award-fill text-warning"></i>
                        <span>Generar Diploma Oficial</span>
                    </a>
                    {% endif %}
                </div>

                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-2 bg-light border">
                            <div class="small text-muted mb-1">Total Visitas</div>
                            <div class="fs-4 fw-bold text-dark d-flex align-items-center gap-2">
                                <span>{{ client.totalAccesses }}</span>
                                {% if client.totalAccesses == 0 and client.totalPaid > 0 %}
                                    <span class="badge bg-warning-subtle text-warning-emphasis small px-2 py-0.5 rounded-pill" style="font-size: 0.68rem;">👻 Fantasma</span>
                                {% endif %}
                            </div>
                            <div class="text-muted small mt-0.5">Accesos registrados</div>
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-2 bg-light border">
                            <div class="small text-muted mb-1">Total Invertido</div>
                            <div class="fs-4 fw-bold text-dark">{{ client.totalPaid|number_format(2, ',', '.') }} €</div>
                            <div class="text-muted small mt-0.5">Cuotas acumuladas</div>
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-2 bg-light border">
                            <div class="small text-muted mb-1">Coste por Visita</div>
                            <div class="fs-4 fw-bold text-success">{{ client.costPerVisit|number_format(2, ',', '.') }} €</div>
                            <div class="text-muted small mt-0.5">Ratio aportación / uso</div>
                        </div>
                    </div>

                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-2 bg-light border">
                            <div class="small text-muted mb-1">Perfil de Asistencia</div>
                            <div class="mt-1">
                                {% if client.totalPaid > 0 and client.totalAccesses == 0 %}
                                    <span class="badge bg-warning text-dark px-2.5 py-1 rounded-pill fw-bold">👻 Donante Puro (100% Rentable)</span>
                                {% elseif client.costPerVisit >= 50 %}
                                    <span class="badge bg-info-subtle text-info-emphasis px-2.5 py-1 rounded-pill fw-bold">💎 Mecenas de Oro</span>
                                {% elseif client.costPerVisit >= 15 %}
                                    <span class="badge bg-success-subtle text-success px-2.5 py-1 rounded-pill fw-bold">🪙 Socio Rentable</span>
                                {% else %}
                                    <span class="badge bg-primary-subtle text-primary px-2.5 py-1 rounded-pill fw-bold">🏋️ Asiduo Frecuente</span>
                                {% endif %}
                            </div>
                            <div class="text-muted small mt-1">Nivel de rentabilidad</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ─── Access history ─── #}
    {% if recentLogs is not empty %}
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <p class="card-section-title">
                    <i class="bi bi-clock-history" aria-hidden="true"></i>Historial de accesos recientes
                </p>
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Fecha y hora</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for log in recentLogs %}
                                <tr>
                                    <td class="text-nowrap">{{ log.accessTime|date('d/m/Y H:i:s') }}</td>
                                    <td>
                                        {% if log.status == 'success' %}
                                            <span class="badge-status badge-paid"><span class="dot"></span>Acceso autorizado</span>
                                        {% else %}
                                            <span class="badge-status badge-pending"><span class="dot"></span>Denegado</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

</div>

{# ─── Modal Asignar Tarjeta RFID ─── #}
<div class="modal fade" id="cardModal" tabindex="-1" aria-labelledby="cardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" action="{{ path('app_client_assign_card', {'id': client.id}) }}">
                <div class="modal-header">
                    <h5 class="modal-title" id="cardModalLabel">
                        <i class="bi bi-credit-card-2-front me-2"></i>Asignar Tarjeta RFID
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">
                        Pasa la tarjeta por el lector o escribe el código UID manualmente.
                    </p>
                    <input type="hidden" name="_token" value="{{ csrf_token('assign_card' ~ client.id) }}">
                    <div class="mb-3">
                        <label for="cardCodeField" class="form-label">Código UID de la tarjeta</label>
                        <input type="text" class="form-control font-monospace" id="cardCodeField"
                               name="card_code" value="{{ client.cardCode }}" placeholder="Ej: 1641, A3B4C5..." autocomplete="off">
                    </div>
                    <div class="alert alert-info py-2 small mb-0">
                        <i class="bi bi-info-circle me-1"></i>Para desvincular la tarjeta, deja el campo vacío y pulsa guardar.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar tarjeta</button>
                </div>
            </form>
        </div>
    </div>
</div>

{# ─── Modal Ajustar Pases ─── #}
{% if subscription and subscription.subscriptionType.isDailyPass %}
<div class="modal fade" id="passesModal" tabindex="-1" aria-labelledby="passesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <form method="post" action="{{ path('app_subscription_adjust_passes', {'id': subscription.id}) }}">
                <div class="modal-header">
                    <h5 class="modal-title fs-6" id="passesModalLabel">
                        <i class="bi bi-ticket-perforated me-1"></i>Ajustar pases
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="_token" value="{{ csrf_token('adjust_passes' ~ subscription.id) }}">
                    <div class="mb-3">
                        <label for="passesInput" class="form-label">Saldo de pases restantes</label>
                        <input type="number" class="form-control" id="passesInput" name="passes"
                               min="0" max="999" value="{{ subscription.remainingPasses ?? 0 }}" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-primary">Guardar pases</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}

{# ─── Delete modal ─── #}
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-6" id="deleteModalLabel">Confirmar eliminación</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">¿Eliminar a <strong>{{ client.name }} {{ client.surname }}</strong>?</p>
                <p class="small mb-0" style="color:var(--c-danger)">Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                {{ include('client/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    // Polling lector de tarjetas si el modal de asignación está abierto
    document.addEventListener('DOMContentLoaded', function () {
        const cardField = document.getElementById('cardCodeField');
        if (!cardField) return;

        let pollingInterval = null;
        const cardModal = document.getElementById('cardModal');

        if (cardModal) {
            cardModal.addEventListener('shown.bs.modal', function () {
                pollingInterval = setInterval(async function () {
                    try {
                        const res = await fetch('/api/card-read');
                        if (!res.ok) return;
                        const data = await res.json();
                        if (data.success && data.card_id) {
                            cardField.value = data.card_id;
                            cardField.classList.add('is-valid');
                            setTimeout(() => cardField.classList.remove('is-valid'), 2000);
                            await fetch('/api/card-read/clear', { method: 'POST' });
                        }
                    } catch (e) {}
                }, 1200);
            });

            cardModal.addEventListener('hidden.bs.modal', function () {
                if (pollingInterval) clearInterval(pollingInterval);
            });
        }
    });
    </script>
{% endblock %}
