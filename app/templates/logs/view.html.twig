{% extends 'base.html.twig' %}

{% block title %}Logs del {{ date|date('d-m-Y') }}{% endblock %}

{% block page_title %}Logs del {{ date|date('d-m-Y') }}{% endblock %}

{% block body %}
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('logs_view') }}">
                <div class="row g-2">
                    <div class="col-12 col-md-8">
                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-calendar3"></i>
                            </span>
                            <input type="date" 
                                   class="form-control" 
                                   id="date" 
                                   name="date" 
                                   value="{{ date }}">
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search me-2"></i>Ver logs
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {% if logs is empty %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>No hay registros para esta fecha.
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="text-nowrap">ID Cliente</th>
                        <th class="text-nowrap">Nombre Cliente</th>
                        <th class="text-nowrap">Hora de Acceso</th>
                        <th class="text-nowrap">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    {% for log in logs %}
                        <tr>
                            <td data-label="ID Cliente" class="text-nowrap">
                                <span class="d-inline d-md-none fw-bold me-2">ID:</span>
                                {{ log.client_id }}
                            </td>
                            <td data-label="Nombre" class="text-nowrap">
                                <span class="d-inline d-md-none fw-bold me-2">Nombre:</span>
                                {{ log.client_name }}
                            </td>
                            <td data-label="Hora" class="text-nowrap">
                                <span class="d-inline d-md-none fw-bold me-2">Hora:</span>
                                {{ log.access_time }}
                            </td>
                            <td data-label="Estado" class="text-nowrap">
                                <span class="d-inline d-md-none fw-bold me-2">Estado:</span>
                                <span class="badge {{ log.status == 'success' ? 'bg-success' : 'bg-danger' }}">
                                    {{ log.status == 'success' ? 'Autorizado' : 'Denegado' }}
                                </span>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <small class="text-muted">
                Total registros: {{ logs|length }}
            </small>
            <button class="btn btn-outline-primary btn-sm" onclick="window.print()">
                <i class="bi bi-printer me-2"></i>Imprimir
            </button>
        </div>
    {% endif %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('logs') }}
{% endblock %}