{% extends 'base.html.twig' %}

{% block title %}Registros {{ date|date('d/m/Y') }} - GymAdmin{% endblock %}
{% block page_title %}Registros de acceso{% endblock %}

{% block body %}

<div class="page-header">
    <div class="page-header-left">
        <div>
            <h2 class="page-header-title">Registros de acceso</h2>
            <p class="page-header-sub">{{ date|date('d/m/Y') }}</p>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="{{ path('logs_export_csv', {date: date}) }}" class="btn btn-sm btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1" aria-hidden="true"></i>Exportar CSV
        </a>
        {% if logs is not empty %}
            <button class="btn btn-sm btn-outline-secondary" onclick="window.print()" type="button">
                <i class="bi bi-printer me-1" aria-hidden="true"></i>Imprimir
            </button>
        {% endif %}
    </div>
</div>

{# ─── Date filter ─── #}
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="{{ path('logs_view') }}" aria-label="Seleccionar fecha">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-sm-8 col-md-5">
                    <label class="form-label" for="date">Fecha</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background:var(--c-gray-50)">
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                        </span>
                        <input type="date" class="form-control" id="date" name="date" value="{{ date }}">
                    </div>
                </div>
                <div class="col-12 col-sm-4 col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1" aria-hidden="true"></i>Ver
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

{# ─── Log table ─── #}
{% if logs is empty %}
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-calendar-x empty-state-icon" aria-hidden="true"></i>
            <p class="empty-state-title">Sin registros</p>
            <p class="empty-state-desc">No hay registros de acceso para esta fecha.</p>
        </div>
    </div>
{% else %}
    <div class="table-card">
        <div class="table-card-header">
            <h3 class="table-card-title">
                <i class="bi bi-list-check me-1" aria-hidden="true"></i>
                {{ logs|length }} registro{{ logs|length != 1 ? 's' : '' }}
            </h3>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0" aria-label="Registros de acceso">
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Hora</th>
                        <th scope="col">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    {% for log in logs %}
                        <tr>
                            <td class="font-monospace small">{{ log.client_id }}</td>
                            <td>{{ log.client_name }}</td>
                            <td class="text-nowrap">{{ log.access_time }}</td>
                            <td>
                                <span class="badge-status {% if log.status == 'success' %}badge-paid{% else %}badge-pending{% endif %}">
                                    <span class="dot" aria-hidden="true"></span>
                                    {{ log.status == 'success' ? 'Autorizado' : 'Denegado' }}
                                </span>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}

{% endblock %}
