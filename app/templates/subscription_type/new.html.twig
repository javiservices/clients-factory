{% extends 'base.html.twig' %}

{% block title %}Nueva suscripción - GymAdmin{% endblock %}
{% block page_title %}Nueva suscripción{% endblock %}

{% block body %}
<div class="page-header">
    <div class="page-header-left">
        <a href="{{ path('app_subscription_type_index') }}" class="btn btn-sm btn-outline-secondary btn-icon"
           aria-label="Volver a suscripciones">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
        </a>
        <div>
            <h2 class="page-header-title">Nueva suscripción</h2>
            <p class="page-header-sub">Configura un nuevo plan de acceso para los clientes</p>
        </div>
    </div>
</div>

<div class="card" style="max-width:860px">
    <div class="card-body">
        {{ form_start(form) }}

            <p class="card-section-title">
                <i class="bi bi-tag" aria-hidden="true"></i>Información básica
            </p>
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name) }}
                    {{ form_help(form.name) }}
                    {{ form_errors(form.name) }}
                </div>
                <div class="col-12 col-md-6">
                    {{ form_label(form.price) }}
                    {{ form_widget(form.price) }}
                    {{ form_help(form.price) }}
                    {{ form_errors(form.price) }}
                </div>
            </div>

            <p class="card-section-title">
                <i class="bi bi-calendar-event" aria-hidden="true"></i>Duración
            </p>
            <div class="row g-3 mb-4">
                <div class="col-12 col-lg-7">
                    <div class="p-3 rounded" style="background:var(--c-gray-50);border:1px solid var(--c-gray-200)">
                        <div class="form-check mb-3">
                            {{ form_widget(form.isDailyPass) }}
                            {{ form_label(form.isDailyPass) }}
                            <div class="form-text">Si está activo, el campo días se interpreta como número de pases.</div>
                        </div>

                        <div id="durationFields">
                            <div class="mb-3" id="monthsField">
                                {{ form_label(form.months) }}
                                {{ form_widget(form.months) }}
                                {{ form_help(form.months) }}
                                {{ form_errors(form.months) }}
                            </div>
                            <div class="mb-0" id="daysField">
                                {{ form_label(form.days) }}
                                {{ form_widget(form.days) }}
                                {{ form_help(form.days) }}
                                {{ form_errors(form.days) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 justify-content-end pt-2" style="border-top:1px solid var(--c-gray-100)">
                <a href="{{ path('app_subscription_type_index') }}" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>Crear suscripción
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('subscription_forms') }}
{% endblock %}
