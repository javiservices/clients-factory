{% extends 'base.html.twig' %}

{% block title %}Tipo de Suscripción: {{ subscription_type.name }}{% endblock %}
{% block page_title %}Detalles de Suscripción{% endblock %}

{% block body %}
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="mb-4">
                <h3 class="card-title h4 mb-1">{{ subscription_type.name }}</h3>
                <p class="text-muted small mb-3">
                    <i class="bi bi-tag me-1"></i>ID: {{ subscription_type.id }}
                </p>

                <div class="d-flex gap-2">
                    <a href="{{ path('app_subscription_type_index') }}" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left me-2"></i>Volver
                    </a>
                    <a href="{{ path('app_subscription_type_edit', {'id': subscription_type.id}) }}" class="btn btn-primary">
                        <i class="bi bi-pencil-fill me-2"></i>Editar
                    </a>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                        <i class="bi bi-trash-fill me-2"></i>Eliminar
                    </button>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-12">
                    <h5 class="border-bottom pb-2 mb-3 h6">
                        <i class="bi bi-info-circle me-1"></i>Detalles de la Suscripción
                    </h5>
                    <div class="row g-3">
                        <div class="col-6 col-lg-3">
                            <div class="p-2 p-md-3 bg-light rounded-3">
                                <small class="text-muted d-block">Tipo</small>
                                <strong class="small">
                                    <span class="badge {{ subscription_type.isDailyPass ? 'bg-info' : 'bg-primary' }}">
                                        {{ subscription_type.isDailyPass ? 'Pase Diario' : 'Plan Regular' }}
                                    </span>
                                </strong>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="p-2 p-md-3 bg-light rounded-3">
                                <small class="text-muted d-block">Duración</small>
                                <strong class="small">
                                    {% if subscription_type.isDailyPass %}
                                        {{ subscription_type.days }} pase{{ subscription_type.days > 1 ? 's' : '' }}
                                    {% elseif subscription_type.months %}
                                        {{ subscription_type.months }} mes{{ subscription_type.months > 1 ? 'es' : '' }}
                                    {% elseif subscription_type.days %}
                                        {{ subscription_type.days }} día{{ subscription_type.days > 1 ? 's' : '' }}
                                    {% else %}
                                        No definido
                                    {% endif %}
                                </strong>
                            </div>
                        </div>
                        <div class="col-12 col-lg-3">
                            <div class="p-2 p-md-3 bg-light rounded-3">
                                <small class="text-muted d-block">Precio</small>
                                <strong class="small">{{ subscription_type.price }}€</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title h6">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small">¿Estás seguro de que deseas eliminar este tipo de suscripción?</p>
                    <p class="small text-danger mb-0">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    {{ include('subscription_type/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}