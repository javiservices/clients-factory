{% extends 'base.html.twig' %}

{% block title %}Suscripción: {{ subscription_type.name }} - Santamaría Gym{% endblock %}
{% block page_title %}Detalles de suscripción{% endblock %}

{% block body %}

<div class="page-header mb-4">
    <div class="page-header-left">
        <a href="{{ path('app_subscription_type_index') }}" class="btn btn-sm btn-outline-secondary btn-icon"
           aria-label="Volver al listado">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
        </a>
        <div>
            <h2 class="page-header-title">{{ subscription_type.name }}</h2>
            <p class="page-header-sub">Plan #{{ subscription_type.id }}</p>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="{{ path('app_subscription_type_edit', {'id': subscription_type.id}) }}" class="btn btn-primary">
            <i class="bi bi-pencil me-1" aria-hidden="true"></i>Editar
        </a>
        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="bi bi-trash me-1" aria-hidden="true"></i>Eliminar
        </button>
    </div>
</div>

<div class="card" style="max-width: 860px;">
    <div class="card-body">
        <p class="card-section-title">
            <i class="bi bi-info-circle me-2" aria-hidden="true"></i>Detalles del plan
        </p>
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-4">
                <div class="p-3 rounded" style="background:var(--c-gray-50);border:1px solid var(--c-gray-200);">
                    <small class="text-muted d-block">Tipo de acceso</small>
                    <div class="fw-semibold mt-1">
                        <span class="badge-status badge-info-tag">
                            {{ subscription_type.isDailyPass ? 'Pase Diario' : 'Plan Regular' }}
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-4">
                <div class="p-3 rounded" style="background:var(--c-gray-50);border:1px solid var(--c-gray-200);">
                    <small class="text-muted d-block">Duración / Pases</small>
                    <div class="fw-semibold mt-1" style="color:var(--c-gray-900);">
                        {% if subscription_type.isDailyPass %}
                            {{ subscription_type.days }} pase{{ subscription_type.days > 1 ? 's' : '' }}
                        {% elseif subscription_type.months %}
                            {{ subscription_type.months }} mes{{ subscription_type.months > 1 ? 'es' : '' }}
                        {% elseif subscription_type.days %}
                            {{ subscription_type.days }} día{{ subscription_type.days > 1 ? 's' : '' }}
                        {% else %}
                            —
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="p-3 rounded" style="background:var(--c-gray-50);border:1px solid var(--c-gray-200);">
                    <small class="text-muted d-block">Precio por periodo</small>
                    <div class="fw-bold mt-1" style="font-size:1.25rem;color:var(--c-gray-900);">
                        {{ subscription_type.price|number_format(2, ',', '.') }}&nbsp;€
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">¿Estás seguro de que deseas eliminar este tipo de suscripción?</p>
                <div class="small" style="color:var(--c-gray-600)">
                    <strong>Nombre:</strong> {{ subscription_type.name }}<br>
                    <strong>Precio:</strong> {{ subscription_type.price|number_format(2, ',', '.') }} €
                </div>
                <p class="mb-0 mt-3" style="color:var(--c-danger)">
                    <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>Esta acción no se puede deshacer.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                {{ include('subscription_type/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>

{% endblock %}
