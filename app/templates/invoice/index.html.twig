{% extends 'base.html.twig' %}

{% block title %}Facturas{% endblock %}

{% block page_title %}Facturas{% endblock %}

{% block body %}
    <div class="container mt-4">
        <!-- Filtros -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Filtros</h5>
            </div>
            <div class="card-body">
                <form method="GET" class="row g-3">
                    <div class="col-md-3">
                        <label for="start_date" class="form-label">Fecha desde</label>
                        <input type="date" class="form-control" id="start_date" name="start_date" value="{{ filters.start_date }}">
                    </div>
                    <div class="col-md-3">
                        <label for="end_date" class="form-label">Fecha hasta</label>
                        <input type="date" class="form-control" id="end_date" name="end_date" value="{{ filters.end_date }}">
                    </div>
                    <div class="col-md-3">
                        <label for="client_name" class="form-label">Cliente</label>
                        <input type="text" class="form-control" id="client_name" name="client_name" value="{{ filters.client_name }}" placeholder="Nombre del cliente">
                    </div>
                    <div class="col-md-3">
                        <label for="status" class="form-label">Estado</label>
                        <select class="form-select" id="status" name="status">
                            <option value="">Todos</option>
                            <option value="draft" {{ filters.status == 'draft' ? 'selected' : '' }}>Borrador</option>
                            <option value="issued" {{ filters.status == 'issued' ? 'selected' : '' }}>Emitida</option>
                            <option value="paid" {{ filters.status == 'paid' ? 'selected' : '' }}>Pagada</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-primary me-2">
                            <i class="bi bi-search"></i> Filtrar
                        </button>
                        <a href="{{ path('invoice_index') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-x"></i> Limpiar filtros
                        </a>
                        <a href="{{ path('invoice_download_all', filters) }}" class="btn btn-primary me-2">
                            <i class="bi bi-download"></i> Descargar todas (ZIP)
                        </a>
                        <a href="{{ path('profile_edit') }}" class="btn btn-success">
                            <i class="bi bi-plus-circle"></i> Editar Empresa
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Tabla de facturas -->
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Número</th>
                                <th>Cliente</th>
                                <th>Fecha</th>
                                <th>Importe</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for invoice in invoices %}
                            <tr>
                                <td>
                                    <strong>{{ invoice.invoiceNumber }}</strong>
                                </td>
                                <td>
                                    {% if invoice.client %}
                                        {{ invoice.client.name }} {{ invoice.client.surname }}
                                    {% else %}
                                        <span class="text-muted">N/A</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if invoice.issueDate %}
                                        {{ invoice.issueDate|date('d/m/Y') }}
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <strong>{{ invoice.totalAmount|number_format(2, ',', '.') }} €</strong>
                                </td>
                                <td>
                                    {% if invoice.status == 'issued' %}
                                        <span class="badge bg-success">Emitida</span>
                                    {% elseif invoice.status == 'paid' %}
                                        <span class="badge bg-info">Pagada</span>
                                    {% else %}
                                        <span class="badge bg-warning">Borrador</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('invoice_show', {'id': invoice.id}) }}" class="btn btn-sm btn-primary" title="Ver detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="{{ path('invoice_download_pdf', {'id': invoice.id}) }}" class="btn btn-sm btn-info" title="Descargar PDF">
                                            <i class="bi bi-file-earmark-pdf"></i>
                                        </a>
                                        <a href="{{ path('invoice_download', {'id': invoice.id}) }}" class="btn btn-sm btn-success" title="Descargar XML">
                                            <i class="bi bi-download"></i>
                                        </a>
                                        <form method="post" action="{{ path('invoice_delete', {'id': invoice.id}) }}" class="d-inline" onsubmit="return confirm('¿Estás seguro de que quieres eliminar esta factura?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ invoice.id) }}">
                                            <button class="btn btn-sm btn-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="bi bi-inbox fs-2 mb-2"></i>
                                        <br>
                                        No hay facturas que coincidan con los filtros aplicados
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {% if invoices|length > 0 %}
            <div class="mt-3 text-muted">
                <small>Mostrando {{ invoices|length }} factura(s)</small>
            </div>
        {% endif %}
    </div>
{% endblock %}
