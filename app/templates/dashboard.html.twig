{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
    // ── Helper Toast ─────────────────────────────────────────────────────────
    function showToast(message, type = 'success') {
        const region = document.getElementById('toastRegion');
        if (!region) return;
        const icons = {
            'success': 'check-circle-fill',
            'danger': 'x-circle-fill',
            'warning': 'exclamation-triangle-fill',
            'info': 'info-circle-fill'
        };
        const t = type === 'error' ? 'danger' : type;
        const toast = document.createElement('div');
        toast.className = `toast-item toast-${t}`;
        toast.setAttribute('role', 'alert');
        toast.style.animation = 'fadeIn 0.3s ease';
        toast.innerHTML = `
            <i class="bi bi-${icons[t] || 'info-circle-fill'} toast-icon"></i>
            <span class="toast-body">${message}</span>
            <button class="toast-close" aria-label="Cerrar"><i class="bi bi-x"></i></button>
        `;
        const closeBtn = toast.querySelector('.toast-close');
        if (closeBtn) {
            closeBtn.addEventListener('click', () => toast.remove());
        }
        region.appendChild(toast);
        setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transition = 'opacity 0.4s ease';
            setTimeout(() => toast.remove(), 400);
        }, 6000);
    }

    // ── Zero-Flicker Smart Turnstile Monitor ─────────────────────────────────
    // Guardamos el último ID de access_log para NO tocar el DOM si nadie ha pasado
    let currentAccessLogId = {{ latestAccessId|default(0) }};

    function escapeHtml(str) {
        if (!str) return '';
        const p = document.createElement('p');
        p.textContent = str;
        return p.innerHTML;
    }

    function renderTornoClient(client) {
        const container = document.getElementById('liveClientCardContainer');
        const content = document.getElementById('liveClientContent');
        const timeTag = document.getElementById('liveAccessTimeTag');
        if (!container || !content) return;

        if (!client) {
            container.className = 'torno-card';
            if (timeTag) timeTag.textContent = 'En espera de lectura...';
            content.innerHTML = `
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-person-bounding-box fs-1 d-block mb-2 text-secondary"></i>
                    <h5 class="fw-semibold text-dark">Esperando lectura en el torno...</h5>
                    <p class="small text-secondary mb-0">Cuando un socio pase su tarjeta o código, aparecerá aquí al instante sin recargar la página.</p>
                </div>
            `;
            return;
        }

        const isSuccess = client.status === 'success';
        container.className = `torno-card ${isSuccess ? 'is-allowed' : 'is-denied'}`;

        if (timeTag) {
            timeTag.innerHTML = `Último acceso: <strong class="text-dark">${client.accessTimeFormatted || '-'}</strong>`;
        }

        const avatarHtml = client.photoUrl
            ? `<img src="${client.photoUrl}" alt="${client.name}" class="client-avatar-img">`
            : `<div class="client-avatar-placeholder"><i class="bi bi-person"></i></div>`;

        const badgeAccess = isSuccess
            ? `<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>Paso Autorizado</span>`
            : `<span class="badge bg-danger text-white px-2 py-1"><i class="bi bi-x-circle-fill me-1"></i>Acceso Denegado</span>`;

        const subStatusBadge = client.hasPaid
            ? `<span class="badge bg-success-subtle text-success"><i class="bi bi-check-lg me-1"></i>Cuota Activa</span>`
            : `<span class="badge bg-danger-subtle text-danger"><i class="bi bi-exclamation-octagon me-1"></i>Cuota Inactiva</span>`;

        const welcomeBanner = client.welcomeMessage ? `
            <div class="alert py-2 px-3 mb-3 rounded-3 border-0 d-inline-flex align-items-center gap-2" style="background: rgba(220, 38, 38, 0.08); border-left: 4px solid var(--c-primary,#DC2626) !important;">
                <i class="bi bi-chat-quote-fill text-danger fs-5"></i>
                <span class="fw-semibold text-dark">${escapeHtml(client.welcomeMessage)}</span>
            </div>
        ` : '';

        content.innerHTML = `
            <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-start gap-4" style="animation: fadeIn 0.3s ease;">
                <div class="client-avatar-wrap">
                    ${avatarHtml}
                    <span class="avatar-status-dot ${isSuccess ? 'bg-success' : 'bg-danger'}" title="${isSuccess ? 'Autorizado' : 'Denegado'}"></span>
                </div>

                <div class="flex-grow-1 text-center text-sm-start">
                    <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-sm-start gap-2 mb-1">
                        <h3 class="fw-bold mb-0 text-dark">
                            <a href="/client/${client.id}" class="text-dark text-decoration-none">
                                ${escapeHtml(client.name)} ${escapeHtml(client.surname)}
                            </a>
                        </h3>
                        ${badgeAccess}
                    </div>

                    <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-sm-start gap-2 mb-3">
                        <span class="meta-pill"><i class="bi bi-hash me-1"></i>${client.clientNumber || client.id}</span>
                        <span class="meta-pill"><i class="bi bi-credit-card-2-front me-1"></i>${escapeHtml(client.cardCode) || 'Sin tarjeta física'}</span>
                        <span class="meta-pill">
                            <i class="bi bi-calendar-check me-1"></i>${escapeHtml(client.subType)}
                            ${client.endDate ? `· Vence: <strong class="ms-1">${client.endDate}</strong>` : ''}
                        </span>
                        ${subStatusBadge}
                    </div>

                    ${welcomeBanner}

                    <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-sm-start gap-2 pt-2">
                        <form method="post" action="/client/${client.id}/renew" class="d-inline js-renew-form">
                            <input type="hidden" name="_token" value="${client.csrfToken || ''}">
                            <input type="hidden" name="return_to" value="dashboard">
                            <button type="submit" class="btn btn-success fw-semibold shadow-sm js-renew-btn" data-client-id="${client.id}">
                                <i class="bi bi-arrow-repeat me-1"></i>Renovar Cuota
                            </button>
                        </form>
                        <a href="/client/${client.id}/edit?return_to=dashboard" class="btn btn-outline-secondary">
                            <i class="bi bi-pencil-square me-1"></i>Editar
                        </a>
                        <a href="/client/${client.id}" class="btn btn-outline-dark">
                            <i class="bi bi-person-lines-fill me-1"></i>Ficha
                        </a>
                    </div>
                </div>
            </div>
        `;
    }

    function renderRecentList(recent) {
        const listContainer = document.getElementById('recentAccessesList');
        if (!listContainer || !recent) return;

        if (recent.length === 0) {
            listContainer.innerHTML = '<div class="text-center py-4 text-muted small">Sin accesos registrados aún hoy.</div>';
            return;
        }

        listContainer.innerHTML = recent.map(item => `
            <div class="recent-item">
                <div class="d-flex align-items-center gap-2 min-w-0">
                    ${item.photoUrl
                        ? `<img src="${item.photoUrl}" alt="${escapeHtml(item.name)}" class="rounded-circle object-fit-cover" style="width:32px;height:32px;">`
                        : `<div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-secondary" style="width:32px;height:32px;font-size:0.9rem;"><i class="bi bi-person"></i></div>`
                    }
                    <div class="min-w-0">
                        <a href="/client/${item.clientId}" class="text-dark fw-semibold text-truncate d-block small text-decoration-none">
                            ${escapeHtml(item.name)}
                        </a>
                        <span class="text-muted" style="font-size:0.75rem;">${item.accessTime}</span>
                    </div>
                </div>
                <div>
                    ${item.status === 'success'
                        ? `<span class="badge bg-success-subtle text-success rounded-pill" style="font-size:0.72rem;">OK</span>`
                        : `<span class="badge bg-danger rounded-pill" style="font-size:0.72rem;">Denegado</span>`
                    }
                </div>
            </div>
        `).join('');
    }

    // ── Polling inteligente del Torno (CERO recargas si no pasa tarjeta) ─────
    async function checkTurnstile() {
        try {
            const res = await fetch('/api/turnstile-clients');
            if (!res.ok) return;
            const data = await res.json();

            // Actualizar reloj en vivo del header
            const now = new Date();
            const timeString = now.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            const clockEl = document.getElementById('liveClock');
            if (clockEl) clockEl.textContent = `(${timeString})`;

            // CONDICIÓN CLAVE: Si el ID del último acceso no ha cambiado, NO TOCAMOS EL DOM
            if (data.latestAccessId === currentAccessLogId) {
                return;
            }

            // Si es diferente, realmente ha pasado alguien por el torno
            currentAccessLogId = data.latestAccessId;
            renderTornoClient(data.client);
            renderRecentList(data.recent);

            if (data.client) {
                playAccessSound(data.client.status === 'success');
            }

            // Refrescamos las estadísticas suavemente
            loadStats();

        } catch (err) {
            console.error('Error comprobando torno:', err);
        }
    }

    // ── Intercepción AJAX de Renovaciones con Toast ─────────────────────────
    document.addEventListener('submit', function(e) {
        const form = e.target.closest('.js-renew-form');
        if (!form) return;

        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Renovando...';
        }

        fetch(form.action, {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new FormData(form)
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                showToast(data.message || 'Suscripción renovada con éxito.', 'success');
                if (submitBtn) {
                    submitBtn.className = 'btn btn-success fw-semibold shadow-sm disabled';
                    submitBtn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>¡Renovado!';
                }
                // Refrescamos estadísticas para actualizar el conteo de activos
                loadStats();
            } else {
                showToast(data.message || 'No se pudo renovar la suscripción.', 'danger');
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Reintentar';
                }
            }
        })
        .catch(err => {
            console.error('Error en renovación:', err);
            showToast('Error de conexión al procesar la renovación.', 'danger');
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Renovar Cuota';
            }
        });
    });

    // ── Stats y Gráficas ─────────────────────────────────────────────────────
    let chartByDay  = null;
    let chartByHour = null;

    async function loadStats() {
        try {
            const res  = await fetch('/api/stats');
            const data = await res.json();

            document.getElementById('statToday').textContent    = data.todayCount ?? 0;
            document.getElementById('statTotal').textContent    = data.totalActiveClients ?? data.totalClients ?? 0;
            document.getElementById('statExpiring').textContent = data.expiring?.length ?? 0;
            const denied = data.byStatus?.denied ?? 0;
            document.getElementById('statDenied').textContent   = denied;

            if (data.currentOccupancy !== undefined) {
                const occEl = document.getElementById('liveOccupancyVal');
                if (occEl) occEl.textContent = data.currentOccupancy;
            }

            // Gráfica de barras: accesos por día
            const days   = Object.keys(data.accessesByDay || {});
            const counts = Object.values(data.accessesByDay || {});
            const dayLabels = days.map(d => {
                const [y, m, day] = d.split('-');
                return `${day}/${m}`;
            });

            const ctxDay = document.getElementById('chartByDay');
            if (ctxDay) {
                if (chartByDay) {
                    chartByDay.data.labels = dayLabels;
                    chartByDay.data.datasets[0].data = counts;
                    chartByDay.update('none');
                } else {
                    chartByDay = new Chart(ctxDay, {
                        type: 'bar',
                        data: {
                            labels: dayLabels,
                            datasets: [{
                                label: 'Accesos',
                                data: counts,
                                backgroundColor: 'rgba(220, 38, 38, 0.75)',
                                borderColor: '#DC2626',
                                borderWidth: 1,
                                borderRadius: 4,
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: { padding: 10, cornerRadius: 8 }
                            },
                            scales: {
                                x: {
                                    grid: { display: false },
                                    ticks: { maxTicksLimit: 15, font: { size: 11 } }
                                },
                                y: {
                                    beginAtZero: true,
                                    ticks: { stepSize: 1, precision: 0, font: { size: 11 } },
                                    grid: { color: 'rgba(0,0,0,0.05)' }
                                }
                            }
                        }
                    });
                }
            }

            // Gráfica de línea: distribución por hora
            const hours = data.byHour || Array(24).fill(0);
            const hourLabels = Array.from({length: 24}, (_, i) => `${i}h`);
            const ctxHour = document.getElementById('chartByHour');
            if (ctxHour) {
                if (chartByHour) {
                    chartByHour.data.labels = hourLabels;
                    chartByHour.data.datasets[0].data = hours;
                    chartByHour.update('none');
                } else {
                    chartByHour = new Chart(ctxHour, {
                        type: 'line',
                        data: {
                            labels: hourLabels,
                            datasets: [{
                                label: 'Accesos',
                                data: hours,
                                borderColor: '#DC2626',
                                backgroundColor: 'rgba(220, 38, 38, 0.12)',
                                tension: 0.35,
                                fill: true,
                                pointRadius: 2.5,
                                pointHoverRadius: 5,
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: { padding: 10, cornerRadius: 8 }
                            },
                            scales: {
                                x: {
                                    grid: { display: false },
                                    ticks: { maxTicksLimit: 12, font: { size: 11 } }
                                },
                                y: {
                                    beginAtZero: true,
                                    ticks: { stepSize: 1, precision: 0, font: { size: 11 } },
                                    grid: { color: 'rgba(0,0,0,0.05)' }
                                }
                            }
                        }
                    });
                }
            }

            // Tabla de próximos vencimientos
            const expiring = data.expiring || [];
            const tbody = document.getElementById('expiringBody');
            if (expiring.length > 0) {
                document.getElementById('expiringCard').style.display = '';
                tbody.innerHTML = expiring.map(e => `
                    <tr>
                        <td><a href="/client/${e.clientId}" class="fw-semibold text-decoration-none text-dark">${escapeHtml(e.clientName)}</a></td>
                        <td><span class="badge bg-secondary-subtle text-secondary">${escapeHtml(e.type)}</span></td>
                        <td class="text-danger fw-semibold">${e.endDate}</td>
                        <td class="text-end">
                            <a href="/client/${e.clientId}/edit?return_to=dashboard" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size:0.78rem;">Renovar</a>
                        </td>
                    </tr>
                `).join('');
            } else {
                document.getElementById('expiringCard').style.display = 'none';
            }

        } catch (e) {
            console.error('Error cargando estadísticas:', e);
        }
    }

    // ── Sonidos de Acceso & Kiosco Fullscreen ─────────────────────────────
    let audioCtx = null;
    let soundEnabled = localStorage.getItem('gym_sound_enabled') !== 'false';
    const toggleAudioBtn = document.getElementById('toggleAudioBtn');
    const audioIcon = document.getElementById('audioIcon');

    function updateAudioUI() {
        if (!audioIcon || !toggleAudioBtn) return;
        if (soundEnabled) {
            audioIcon.className = 'bi bi-volume-up text-success';
            toggleAudioBtn.title = 'Sonido de accesos activado (clic para silenciar)';
        } else {
            audioIcon.className = 'bi bi-volume-mute text-secondary';
            toggleAudioBtn.title = 'Sonido de accesos silenciado (clic para activar)';
        }
    }
    updateAudioUI();

    if (toggleAudioBtn) {
        toggleAudioBtn.addEventListener('click', () => {
            soundEnabled = !soundEnabled;
            localStorage.setItem('gym_sound_enabled', soundEnabled ? 'true' : 'false');
            updateAudioUI();
            if (soundEnabled) {
                playAccessSound(true);
            }
        });
    }

    function playAccessSound(isSuccess) {
        if (!soundEnabled) return;
        try {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            const now = audioCtx.currentTime;
            if (isSuccess) {
                // Doble tono ascendente agradable (Re5 -> La5)
                osc.type = 'sine';
                osc.frequency.setValueAtTime(587.33, now);
                osc.frequency.setValueAtTime(880.00, now + 0.12);
                gain.gain.setValueAtTime(0.18, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.45);
                osc.start(now);
                osc.stop(now + 0.45);
            } else {
                // Tono de aviso grave (Mi4 -> Do4)
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(329.63, now);
                osc.frequency.setValueAtTime(261.63, now + 0.15);
                gain.gain.setValueAtTime(0.22, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.55);
                osc.start(now);
                osc.stop(now + 0.55);
            }
        } catch (e) {
            console.warn('Audio no disponible:', e);
        }
    }

    const toggleKioskBtn = document.getElementById('toggleKioskBtn');
    const liveContainer = document.getElementById('liveClientCardContainer');
    if (toggleKioskBtn && liveContainer) {
        toggleKioskBtn.addEventListener('click', () => {
            if (!document.fullscreenElement) {
                liveContainer.requestFullscreen().catch(err => {
                    console.warn('Error al activar fullscreen:', err);
                });
            } else {
                document.exitFullscreen();
            }
        });
    }

    // Inicializar polling cada 2.5 segundos
    setInterval(checkTurnstile, 2500);

    // Cargar estadísticas iniciales y refrescar cada 30 segundos
    loadStats();
    setInterval(loadStats, 30000);
    </script>
{% endblock %}
