{# ─── Sidebar ─── #}
<aside id="sidebar" aria-label="Menú de navegación">
    <a class="sidebar-brand" href="{{ path('dashboard') }}" aria-label="Ir al dashboard">
        <span class="sidebar-brand-icon" aria-hidden="true"><i class="bi bi-lightning-charge-fill"></i></span>
        <span class="sidebar-brand-text">GymAdmin</span>
    </a>

    <nav class="sidebar-nav" aria-label="Navegación principal">
        <span class="sidebar-section-label">General</span>

        <a class="sidebar-link {{ app.request.get('_route') == 'dashboard' ? 'active' : '' }}"
           href="{{ path('dashboard') }}" aria-current="{{ app.request.get('_route') == 'dashboard' ? 'page' : 'false' }}">
            <i class="bi bi-speedometer2" aria-hidden="true"></i>
            Dashboard
        </a>

        <a class="sidebar-link {{ app.request.get('_route') starts with 'app_client' ? 'active' : '' }}"
           href="{{ path('app_client_index') }}" aria-current="{{ app.request.get('_route') starts with 'app_client' ? 'page' : 'false' }}">
            <i class="bi bi-people" aria-hidden="true"></i>
            Clientes
        </a>

        <a class="sidebar-link {{ app.request.get('_route') starts with 'app_subscription_type' ? 'active' : '' }}"
           href="{{ path('app_subscription_type_index') }}" aria-current="{{ app.request.get('_route') starts with 'app_subscription_type' ? 'page' : 'false' }}">
            <i class="bi bi-journal-text" aria-hidden="true"></i>
            Suscripciones
        </a>

        <a class="sidebar-link {{ app.request.get('_route') starts with 'logs' ? 'active' : '' }}"
           href="{{ path('logs_view') }}" aria-current="{{ app.request.get('_route') starts with 'logs' ? 'page' : 'false' }}">
            <i class="bi bi-bookmark-check" aria-hidden="true"></i>
            Registros
        </a>

        <span class="sidebar-section-label">Cuenta</span>

        <a class="sidebar-link {{ app.request.get('_route') starts with 'profile' ? 'active' : '' }}"
           href="{{ path('profile_edit') }}" aria-current="{{ app.request.get('_route') starts with 'profile' ? 'page' : 'false' }}">
            <i class="bi bi-person-gear" aria-hidden="true"></i>
            Perfil
        </a>

        {% if app.session.get('system_mode') == 'hidden' %}
        <a class="sidebar-link {{ app.request.get('_route') starts with 'app_backup' ? 'active' : '' }}"
           href="{{ path('app_backup_index') }}" aria-current="{{ app.request.get('_route') starts with 'app_backup' ? 'page' : 'false' }}">
            <i class="bi bi-database" aria-hidden="true"></i>
            Backups
        </a>
        {% endif %}
    </nav>

    <div class="sidebar-footer">
        <a class="sidebar-link sidebar-link-danger" href="{{ path('app_logout') }}">
            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
            Cerrar sesión
        </a>
    </div>
</aside>
