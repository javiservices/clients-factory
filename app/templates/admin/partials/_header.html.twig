{# ─── Topbar ─── #}
<header class="topbar" role="banner">
    <div class="topbar-left d-flex align-items-center flex-shrink-0">
        <button class="btn-sidebar-toggle" type="button" aria-label="Abrir menú" aria-controls="sidebar" aria-expanded="false">
            <i class="bi bi-list fs-5" aria-hidden="true"></i>
        </button>
        <h1 class="topbar-title d-none d-sm-block ms-2" aria-label="{{ page_title }}">{{ page_title }}</h1>
    </div>

    {# ─── Buscador Global Rápido de Usuarios (Ctrl+K) ─── #}
    <div class="topbar-search-wrap position-relative mx-1 mx-sm-2 mx-md-3 flex-grow-1" style="max-width: 440px;">
        <div class="topbar-search-box d-flex align-items-center">
            <i class="bi bi-search topbar-search-ico text-muted" aria-hidden="true"></i>
            <input type="text"
                   id="globalSearchInput"
                   class="form-control form-control-sm topbar-search-input"
                   placeholder="Buscar cliente..."
                   autocomplete="off"
                   spellcheck="false"
                   aria-label="Buscar cliente globalmente"
                   aria-expanded="false"
                   aria-autocomplete="list"
                   role="combobox">
            <span class="topbar-search-badge d-none d-sm-inline-flex" title="Atajo de teclado">
                <kbd>Ctrl</kbd><kbd>K</kbd>
            </span>
        </div>
        <div id="globalSearchResults"
             class="topbar-search-results shadow-lg rounded-3 d-none"
             role="listbox"
             aria-label="Resultados de búsqueda">
        </div>
    </div>

    <div class="topbar-right d-flex align-items-center flex-shrink-0">
        {% if app.session.get('system_mode') == 'hidden' %}
        <span class="mode-badge" title="Modo Restringido activo">
            <i class="bi bi-eye-slash" aria-hidden="true"></i>
            <span class="d-none d-sm-inline">Restringido</span>
        </span>
        {% endif %}

        <div class="topbar-user-menu" data-user-menu>
            <button class="user-avatar-btn" type="button"
                    id="dropdownUser"
                    aria-expanded="false" aria-label="Menú de usuario"
                    data-user-menu-trigger>
                {{ app.user ? app.user.email|slice(0,1)|upper : 'U' }}
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownUser" data-user-menu-panel>
                <li>
                    <span class="dropdown-item-text fw-semibold" style="font-size:.8rem;color:var(--c-gray-500)">
                        {{ app.user ? app.user.email : '' }}
                    </span>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item" href="{{ path('profile_edit') }}">
                        <i class="bi bi-person me-2" aria-hidden="true"></i>Perfil
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="{{ path('app_client_system_mode', {'action': app.session.get('system_mode') == 'hidden' ? 'normal' : 'hidden'}) }}">
                        <i class="bi bi-{{ app.session.get('system_mode') == 'hidden' ? 'eye' : 'eye-slash' }} me-2" aria-hidden="true"></i>
                        Modo {{ app.session.get('system_mode') == 'hidden' ? 'Normal' : 'Restringido' }}
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                        <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Cerrar sesión
                    </a>
                </li>
            </ul>
        </div>
    </div>
</header>

<style>
.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow: visible !important;
    position: sticky;
    top: 0;
    z-index: 1020;
}
.topbar-user-menu {
    position: relative;
}
.topbar-user-menu .dropdown-menu {
    position: absolute !important;
    top: calc(100% + 0.5rem) !important;
    right: 0 !important;
    left: auto !important;
    margin-top: 0 !important;
    z-index: 1070 !important;
    border: 1px solid var(--c-gray-200, #E5E7EB) !important;
    border-radius: 12px !important;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
    background: #ffffff !important;
    min-width: 220px !important;
}
.topbar-user-menu .dropdown-menu.show {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
}
.topbar-left {
    flex-shrink: 0;
}
.topbar-right {
    flex-shrink: 0;
}
.topbar-search-wrap {
    min-width: 0 !important;
    max-width: 440px;
    flex: 1 1 auto;
}
.topbar-search-box {
    position: relative;
    background: #f8fafc;
    border: 1px solid var(--c-gray-200, #e2e8f0);
    border-radius: 999px;
    padding: 0.25rem 0.65rem 0.25rem 0.75rem;
    transition: all 0.2s ease;
    width: 100%;
    box-sizing: border-box;
}
.topbar-search-box:focus-within {
    background: #ffffff;
    border-color: var(--c-primary, #D72638);
    box-shadow: 0 0 0 3px rgba(215, 38, 56, 0.12);
}
.topbar-search-ico {
    font-size: 0.85rem;
    margin-right: 0.5rem;
    color: var(--c-gray-400, #94a3b8);
    flex-shrink: 0;
}
.topbar-search-input {
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 0.2rem 0 !important;
    font-size: 0.85rem !important;
    color: var(--c-gray-900, #0f172a) !important;
    outline: none !important;
    width: 100%;
    min-width: 0 !important;
}
.topbar-search-input::placeholder {
    color: var(--c-gray-400, #94a3b8);
}
@media (max-width: 575.98px) {
    .topbar {
        padding: 0 0.5rem !important;
        gap: 0.35rem !important;
    }
    .topbar-left {
        flex-shrink: 0 !important;
    }
    .topbar-right {
        flex-shrink: 0 !important;
    }
    .topbar-search-wrap {
        margin: 0 0.25rem !important;
    }
    .topbar-search-box {
        padding: 0.2rem 0.5rem !important;
    }
    .topbar-search-ico {
        font-size: 0.78rem !important;
        margin-right: 0.3rem !important;
    }
    .topbar-search-input {
        font-size: 0.8rem !important;
    }
    .user-avatar-btn {
        width: 32px !important;
        height: 32px !important;
        font-size: 0.8rem !important;
    }
    .btn-sidebar-toggle {
        width: 34px !important;
        height: 34px !important;
        padding: 0 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
    }
}
.topbar-search-badge {
    display: inline-flex;
    gap: 0.15rem;
    margin-left: 0.4rem;
    flex-shrink: 0;
}
.topbar-search-badge kbd {
    background: #e2e8f0;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    font-size: 0.65rem;
    font-family: monospace;
    font-weight: 600;
}
.topbar-search-results {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: #ffffff;
    border: 1px solid var(--c-gray-200, #e2e8f0);
    border-radius: 12px;
    z-index: 1060;
    max-height: 420px;
    overflow-y: auto;
    padding: 0.35rem;
}
.search-result-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background 0.12s ease;
}
.search-result-item:hover, .search-result-item.is-selected {
    background: #f1f5f9;
    color: inherit;
}
.search-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fee2e2;
    color: #b91c1c;
    font-size: 0.78rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    object-fit: cover;
}
.search-avatar.avatar-palette-0 { background: linear-gradient(135deg, #FFE4E6 0%, #FECDD3 100%) !important; color: #BE123C !important; }
.search-avatar.avatar-palette-1 { background: linear-gradient(135deg, #DCFCE7 0%, #BBF7D0 100%) !important; color: #15803D !important; }
.search-avatar.avatar-palette-2 { background: linear-gradient(135deg, #E0E7FF 0%, #C7D2FE 100%) !important; color: #4338CA !important; }
.search-avatar.avatar-palette-3 { background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%) !important; color: #B45309 !important; }
.search-avatar.avatar-palette-4 { background: linear-gradient(135deg, #F3E8FF 0%, #E9D5FF 100%) !important; color: #7E22CE !important; }
.search-avatar.avatar-palette-5 { background: linear-gradient(135deg, #CCFBF1 0%, #99F6E4 100%) !important; color: #0F766E !important; }
.search-badge-warning {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: #fef3c7;
    color: #92400e;
    flex-shrink: 0;
}
.search-info {
    min-width: 0;
    flex: 1 1 auto;
}
.search-name {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--c-gray-900, #0f172a);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.search-meta {
    font-size: 0.75rem;
    color: var(--c-gray-500, #64748b);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.search-badge-paid {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: #dcfce7;
    color: #15803d;
    flex-shrink: 0;
}
.search-badge-pending {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: #fee2e2;
    color: #b91c1c;
    flex-shrink: 0;
}
.search-loading, .search-empty {
    padding: 1rem;
    text-align: center;
    font-size: 0.82rem;
    color: var(--c-gray-500, #64748b);
}
@media (max-width: 576px) {
    .topbar { padding: 0 0.5rem !important; }
    .topbar-title { display: none !important; }
    .topbar-left { gap: 0.25rem !important; }
    .topbar-right { gap: 0.25rem !important; }
    .topbar-search-wrap { max-width: none !important; margin: 0 0.35rem !important; flex: 1 1 auto !important; }
    .topbar-search-box { padding: 0.2rem 0.5rem !important; }
    .topbar-search-input { font-size: 0.8rem !important; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('globalSearchInput');
    const results = document.getElementById('globalSearchResults');
    if (!input || !results) return;

    let debounceTimer = null;
    let selectedIndex = -1;

    // Atajo global Ctrl+K o /
    document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            input.focus();
            input.select();
        } else if (e.key === '/' && document.activeElement !== input && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
            e.preventDefault();
            input.focus();
            input.select();
        }
    });

    const searchClients = async (query) => {
        if (query.trim().length < 2) {
            results.classList.add('d-none');
            results.innerHTML = '';
            selectedIndex = -1;
            return;
        }

        results.innerHTML = '<div class="search-loading"><i class="bi bi-arrow-repeat spin me-2"></i>Buscando clientes...</div>';
        results.classList.remove('d-none');

        try {
            const resp = await fetch(`/client/quick-search?q=${encodeURIComponent(query)}`);
            if (!resp.ok) throw new Error('Network error');
            const data = await resp.json();
            selectedIndex = -1;

            if (!data.length) {
                results.innerHTML = `<div class="search-empty"><i class="bi bi-person-x me-1"></i>No se encontraron clientes para "<strong>${escapeHtml(query)}</strong>"</div>`;
                return;
            }

            let html = '';
            data.forEach((client, idx) => {
                const paletteClass = `avatar-palette-${client.paletteIndex || 0}`;
                const avatar = client.photoUrl 
                    ? `<img src="${client.photoUrl}" alt="${escapeHtml(client.name)}" class="search-avatar">`
                    : `<div class="search-avatar ${paletteClass}">${escapeHtml(client.initials)}</div>`;
                
                const meta = [`#${client.clientNumber || client.id}`];
                if (client.phone) meta.push(client.phone);
                if (client.cardCode) meta.push(`RFID: ${client.cardCode}`);
                meta.push(client.subscriptionType);

                let statusBadge = '';
                if (client.hasPaid) {
                    if (client.daysRemaining !== null && client.daysRemaining <= 3 && client.daysRemaining >= 0) {
                        statusBadge = `<span class="search-badge-warning"><i class="bi bi-hourglass-split me-0.5"></i>${client.daysRemaining === 0 ? 'Vence hoy' : client.daysRemaining + 'd'}</span>`;
                    } else {
                        statusBadge = '<span class="search-badge-paid"><i class="bi bi-check me-1"></i>Pagado</span>';
                    }
                } else {
                    if (client.daysRemaining !== null && client.daysRemaining < 0) {
                        statusBadge = '<span class="search-badge-pending"><i class="bi bi-exclamation-triangle me-1"></i>Expirado</span>';
                    } else {
                        statusBadge = '<span class="search-badge-pending"><i class="bi bi-clock me-1"></i>Pendiente</span>';
                    }
                }

                const waBtn = (client.cleanPhone && client.cleanPhone.length >= 9)
                    ? `<a href="https://wa.me/34${client.cleanPhone}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-light border text-success p-1 px-2 ms-1" title="Enviar WhatsApp" onclick="event.stopPropagation()"><i class="bi bi-whatsapp"></i></a>`
                    : '';

                html += `
                    <div class="d-flex align-items-center justify-content-between search-result-item" data-index="${idx}">
                        <a href="${client.url}" class="d-flex align-items-center gap-2.5 text-decoration-none text-dark flex-grow-1 min-w-0">
                            ${avatar}
                            <div class="search-info">
                                <div class="search-name">${escapeHtml(client.name)}</div>
                                <div class="search-meta">${escapeHtml(meta.join(' · '))}</div>
                            </div>
                        </a>
                        <div class="d-flex align-items-center gap-1.5 flex-shrink-0 ms-2">
                            ${statusBadge}
                            ${waBtn}
                        </div>
                    </div>
                `;
            });

            results.innerHTML = html;
        } catch (err) {
            results.innerHTML = '<div class="search-empty text-danger"><i class="bi bi-exclamation-triangle me-1"></i>Error en la búsqueda</div>';
        }
    };

    input.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
            searchClients(e.target.value);
        }, 220);
    });

    input.addEventListener('keydown', (e) => {
        const items = results.querySelectorAll('.search-result-item');
        if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (items.length > 0) {
                selectedIndex = (selectedIndex + 1) % items.length;
                updateSelection(items);
            }
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (items.length > 0) {
                selectedIndex = (selectedIndex - 1 + items.length) % items.length;
                updateSelection(items);
            }
        } else if (e.key === 'Enter') {
            if (selectedIndex >= 0 && items[selectedIndex]) {
                e.preventDefault();
                const link = items[selectedIndex].querySelector('a') || items[selectedIndex];
                link.click();
            }
        } else if (e.key === 'Escape') {
            results.classList.add('d-none');
            input.blur();
        }
    });

    function updateSelection(items) {
        items.forEach((it, idx) => {
            if (idx === selectedIndex) {
                it.classList.add('is-selected');
                it.scrollIntoView({ block: 'nearest' });
            } else {
                it.classList.remove('is-selected');
            }
        });
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    document.addEventListener('click', (e) => {
        if (!input.contains(e.target) && !results.contains(e.target)) {
            results.classList.add('d-none');
        }
    });

    input.addEventListener('focus', () => {
        if (input.value.trim().length >= 2 && results.innerHTML.trim() !== '') {
            results.classList.remove('d-none');
        }
    });
});
</script>
